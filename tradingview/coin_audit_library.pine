//@version=6
// ============================================================================================================
//  COIN AUDIT · 27-STRATEGY LIBRARY · v2
//  TradingView port of the Coin Audit Bot: audit/strategies.py (27 strategies), audit/patterns.py (pivot engine,
//  chart patterns, candlesticks, bearish blockers), audit/regime.py (coin regime), audit/market.py (crypto-wide +
//  macro regime and its gate), audit/checks.py (score and verdict), audit/validation.py (backtest mechanics).
//
//  ON THE CHART
//    ▲ green label  a VALIDATED strategy fired on a closed candle, its regime fits and nothing blocks it (APPROVED)
//    ● grey label   a strategy fired (hover the label: which ones, why approved or blocked, stops, chart stats)
//    yellow line    nearest armed breakout level (wait for a candle CLOSE above it with volume)
//    pattern lines  necklines, range boxes, triangle / wedge / channel / trend lines, cup rims (green = broke out)
//    red lines      bearish patterns: M top, head & shoulders, bear flag, falling triangles / rising wedge,
//                   rounding top (they block new longs for 3 candles)
//    plan (right)   entry zone, stop, T1 = 1.5R, T2 = 3R, position size for your risk %
//    dashboard      verdict 0-100, WHAT TO DO, market, plan, checks, and per strategy: regime fit, state now,
//                   chart-backtest trades / win % / profit factor / expectancy / status (hover names = how it works)
//
//  VALIDATION ON A CHART: every strategy is also paper-traded on the loaded history with the bot's mechanics
//  (signal on close, fill next open, stops / targets / ROI / trailing / time stops, cooldown and stoploss guard,
//  fees + slippage both sides). "PASS" = enough trades, profit factor ≥ gate, still profitable at 2x costs, and at
//  least 3 profitable-on-average trades in the holdout (the last 15 % of the chart). That is a reduced version of the
//  bot's 12 walk-forward gates; the bot's verdict is the stronger evidence. Full specification of every rule:
//  tradingview/INDICATOR_PROMPT.md
//
//  No repainting: decisions use closed candles; higher timeframes use their last CLOSED candle.
//  Read-only research tool. It never places orders. Not financial advice.
// ============================================================================================================
indicator("Coin Audit · 27-strategy library v2", "CoinAudit27", overlay = true, max_labels_count = 500,
          max_lines_count = 500, max_boxes_count = 200)

// ================================================================================================== INPUTS
GD = "① Display"
theme      = input.string("Auto", "Theme", options = ["Auto", "Dark", "Light"], group = GD,
                          tooltip = "Auto follows your chart background colour.")
boardMode  = input.string("Full", "Dashboard", options = ["Full", "Compact", "Off"], group = GD,
                          tooltip = "Full: verdict, what to do, market, plan, checks and all 27 strategies with their chart-backtest stats.\nCompact: the header plus only the strategies that are active or validated now.")
boardPosIn = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Top center", "Middle right",
                          "Middle left", "Bottom right", "Bottom left", "Bottom center"], group = GD)
boardTxt   = input.string("Small", "Dashboard text", options = ["Tiny", "Small", "Normal"], group = GD)
labelMode  = input.string("All signals", "Signal labels", options = ["All signals", "Approved only", "Off"], group = GD,
                          tooltip = "Labels sit under the candle that fired. Hover a label for the full explanation.")
showPlan   = input.bool(true, "Trade plan", group = GD, inline = "d1")
showDraw   = input.bool(true, "Pattern lines", group = GD, inline = "d1")
showEma    = input.bool(true, "EMA 20/50/200", group = GD, inline = "d2")
showBg     = input.bool(true, "Risk-off background", group = GD, inline = "d2")
colUp      = input.color(#089981, "Bull", group = GD, inline = "c1")
colDn      = input.color(#f23645, "Bear", group = GD, inline = "c1")
colAppr    = input.color(#00c853, "Approved", group = GD, inline = "c1")
colSetup   = input.color(#ffa726, "Setup", group = GD, inline = "c1")
colPlan    = input.color(#2962ff, "Plan", group = GD, inline = "c1")

GA = "② Signals & approval"
apprMode   = input.string("Auto: chart-backtest gates", "A strategy is validated by", options = ["Auto: chart-backtest gates",
                          "Manual: my ✓ list", "Auto or manual"], group = GA,
                          tooltip = "Only VALIDATED strategies can produce an APPROVED signal.\nAuto: the strategy passed the chart-backtest gates (section ③).\nManual: you marked it 'Validated ✓' in section ⑧ (e.g. the strategies the bot reported as ACCEPTED for this coin).")
apprCand   = input.bool(false, "Also approve 'partial' strategies (half risk)", group = GA,
                          tooltip = "The bot also approves CANDIDATE strategies (8+ of its 12 gates) at half the risk. Here 'partial' = profitable on this chart with enough trades, but at least one gate failed.\nOff = only PASS / ✓ strategies can approve.")
useBtc     = input.bool(true, "BTC risk-on filter (daily)", group = GA,
                          tooltip = "BTC daily close above its long EMA (200, or 50 without history) and EMA20 > EMA50 = risk-on.\nOn (as in the bot): strategies 01 05 06 07 08 09 11 24 26 need it, trend / pullback / momentum / dip regimes need it, and risk-off caps the verdict at WATCHLIST.\nOff: BTC is ignored everywhere.")
btcSym     = input.symbol("BINANCE:BTCUSDT", "BTC symbol", group = GA)
useBear    = input.bool(true, "Bearish patterns block longs (3 candles)", group = GA,
                          tooltip = "Double/triple top, head & shoulders, bear flag, rising wedge, descending/symmetrical triangle breaking DOWN with volume block new long approvals for 3 candles.")
useMktGate = input.bool(true, "Market-regime gate", group = GA,
                          tooltip = "Blocks approvals in a high-volatility event, a BTC selloff, a risk-off rotation, chop (trend modules only), or when the altcoin score < 50 (50-70: only validated strategies). Needs the market layer (⑤).")
minQv24    = input.float(1000000.0, "Minimum 24h volume ($)", minval = 0, step = 100000, group = GA,
                          tooltip = "Below this the verdict is forced to AVOID and nothing is approved (the bot's liquidity floor).")
volMultIn  = input.float(1.2, "Breakout volume ≥ × 30-bar average", minval = 1.0, step = 0.1, group = GA,
                          tooltip = "Chart patterns 13-21 and the bearish blockers. Bot tests 1.2 / 1.5 (V-bottom 1.3 / 1.8, never below 1.3).")
minRR      = input.float(1.5, "Pattern reward : risk at least", minval = 0.5, step = 0.1, group = GA,
                          tooltip = "A pattern breakout only becomes a signal when target − entry ≥ this × (entry − stop). Bot: 1.5.")

GB = "③ Chart backtest gates"
btCost     = input.float(0.15, "Cost per side (%)", minval = 0, step = 0.01, group = GB,
                          tooltip = "Fee + slippage charged on the entry AND the exit of every paper trade (bot: 0.10% fee + 0.05% slippage).")
gMinTr     = input.int(20, "At least N trades", minval = 1, group = GB)
gMinPf     = input.float(1.2, "Profit factor at least", minval = 0.5, step = 0.05, group = GB)
gHoldPct   = input.int(15, "Holdout = last N % of the chart", minval = 0, maxval = 60, group = GB,
                          tooltip = "Trades opened in the last N % of the loaded bars are scored separately (bot: 15 %). The gate needs at least 3 of them and a positive average.")
gNeedHold  = input.bool(true, "Holdout must be profitable", group = GB)

GP = "④ Trade plan & sizing"
planStopAtr = input.float(2.0, "Stop (ATR) when no strategy leads", minval = 0.5, step = 0.25, group = GP)
riskPct    = input.float(1.0, "Risk per trade (%)", minval = 0.1, maxval = 5, step = 0.1, group = GP)
accountUsd = input.float(10000.0, "Account size ($)", minval = 100, step = 100, group = GP)

GM = "⑤ Market layer (crypto-wide + macro)"
useMkt     = input.bool(true, "Market layer", group = GM,
                          tooltip = "TOTAL / TOTAL2 / TOTAL3, BTC and USDT dominance, ETH/BTC, the dollar, VIX and the Nasdaq 100 → the bot's 8 market regimes and the altcoin / BTC eligibility scores (15 % of the verdict).")
symTot     = input.symbol("CRYPTOCAP:TOTAL", "TOTAL", group = GM, inline = "m1")
symTot2    = input.symbol("CRYPTOCAP:TOTAL2", "TOTAL2", group = GM, inline = "m1")
symTot3    = input.symbol("CRYPTOCAP:TOTAL3", "TOTAL3", group = GM, inline = "m2")
symBtcD    = input.symbol("CRYPTOCAP:BTC.D", "BTC.D", group = GM, inline = "m2")
symUsdtD   = input.symbol("CRYPTOCAP:USDT.D", "USDT.D", group = GM, inline = "m3")
symEthBtc  = input.symbol("BINANCE:ETHBTC", "ETH/BTC", group = GM, inline = "m3")
symDxy     = input.symbol("TVC:DXY", "Dollar", group = GM, inline = "m4")
symVix     = input.symbol("TVC:VIX", "VIX", group = GM, inline = "m4")
symNdx     = input.symbol("NASDAQ:NDX", "Nasdaq 100", group = GM, inline = "m5")

G2 = "⑥ Rule strategies (bot defaults)"
adxMin     = input.int(20, "01 EMA/ADX · ADX at least", minval = 5, group = G2, tooltip = "Bot tests 15 / 20 / 25.")
maVotes    = input.int(2, "02 MA ensemble · votes (of 3)", minval = 1, maxval = 3, group = G2, tooltip = "Bot tests 2 / 3 (and the SMA lengths ×0.5 / ×1 / ×2).")
donN       = input.int(20, "03 Donchian · breakout bars", minval = 5, group = G2, tooltip = "Bot tests 20 / 55 / 100.")
momL       = input.int(90, "04 Momentum · lookback", minval = 10, group = G2, inline = "e04")
momMin     = input.float(0.0, "min score", step = 0.1, group = G2, inline = "e04", tooltip = "Bot tests lookback 30 / 90 / 180 and min score 0 / 0.5.")
pbRsi      = input.int(35, "05 Pullback · RSI below", minval = 10, maxval = 60, group = G2, tooltip = "Bot tests 30 / 35 / 40.")
smaOff     = input.float(0.975, "06 SMA offset · close < SMA14 ×", minval = 0.9, maxval = 1, step = 0.005, group = G2, inline = "e06")
smaEwo     = input.float(4.0, "EWO above", step = 0.5, group = G2, inline = "e06", tooltip = "Bot tests offset 0.96 / 0.975 / 0.99 and EWO 2 / 4.")
clucMult   = input.float(0.985, "07 BinCluc · close < lower BB20 ×", minval = 0.9, maxval = 1, step = 0.005, group = G2, tooltip = "Bot tests 0.975 / 0.985 / 0.99.")
ellOff     = input.float(0.978, "08 Elliot · close < EMA17 ×", minval = 0.9, maxval = 1, step = 0.005, group = G2, inline = "e08")
ellEwo     = input.float(3.0, "EWO above", step = 0.5, group = G2, inline = "e08", tooltip = "Bot tests offset 0.97 / 0.978 / 0.985 and EWO 3 / 5.6.")
confK      = input.int(4, "09 Confluence · parts (of 6)", minval = 1, maxval = 6, group = G2, tooltip = "Bot tests 4 / 5.")
emaFast    = input.int(21, "10 EMA cross · fast", minval = 2, group = G2, inline = "e10")
emaSlow    = input.int(55, "slow", minval = 5, group = G2, inline = "e10", tooltip = "Bot tests fast 12 / 21 and slow 55 / 100.")
ictN       = input.int(20, "11 ICT · swing bars", minval = 5, group = G2, inline = "e11")
ictTpR     = input.float(2.0, "target R", minval = 1, step = 0.5, group = G2, inline = "e11", tooltip = "Bot tests swing 20 / 40 bars and target 2R / 3R.")
ddLevel    = input.float(0.85, "12 Drawdown · below ATH by", minval = 0.5, maxval = 0.95, step = 0.05, group = G2, inline = "e12")
ddTp       = input.float(1.0, "target +", minval = 0.2, step = 0.1, group = G2, inline = "e12", tooltip = "Bot tests 0.80 / 0.85 / 0.90 under the ATH and a target of +50 % / +100 %.")

G3 = "⑦ Patterns & price action"
patEntry   = input.string("close", "Pattern entry", options = ["close", "retest"], group = G3, inline = "p1")
patStop    = input.string("pattern", "stop", options = ["pattern", "tight"], group = G3, inline = "p1",
                          tooltip = "close = buy the breakout close · retest = limit 0.1 ATR above the broken level for 5 candles.\npattern = stop beyond the pattern extreme · tight = 1.5 ATR under the level (whichever is closer).\nThe bot tests both of each.")
rsZone     = input.float(0.3, "16 Range support · buy zone (of height)", minval = 0.1, maxval = 0.5, step = 0.05, group = G3, tooltip = "Bot tests 0.2 / 0.3.")
chTouch    = input.float(0.6, "22 Channel · touch within (ATR)", minval = 0.1, step = 0.1, group = G3, tooltip = "Bot tests 0.3 / 0.6.")
calLevel   = input.float(0.3, "23 Candle at level · within (ATR)", minval = 0.1, step = 0.1, group = G3, inline = "p23")
calTpR     = input.float(1.5, "target R", minval = 1, step = 0.5, group = G3, inline = "p23", tooltip = "Bot tests 0.3 / 0.6 ATR and target 1.5R / 2R.")
smcDiv     = input.bool(false, "24 SMC · RSI divergence", group = G3, inline = "p24")
smcTpR     = input.float(2.0, "target R", minval = 1, step = 0.5, group = G3, inline = "p24", tooltip = "Bot tests with and without the divergence, target 2R / 3R.")
fsTpR      = input.float(1.5, "25 RSI failure swing · target R", minval = 1, step = 0.5, group = G3, tooltip = "Bot tests 1.5R / 2.5R.")
sqPct      = input.int(20, "26 Squeeze · BB width lowest %", minval = 5, maxval = 50, group = G3, inline = "p26")
sqVol      = input.float(1.3, "volume ×", minval = 1, step = 0.1, group = G3, inline = "p26", tooltip = "Bot tests the lowest 10 / 20 % and volume 1.3 / 1.8×.")
vwZ        = input.float(2.0, "27 VWAP reversion · z below", minval = 1, step = 0.5, group = G3, tooltip = "Bot tests 2 / 2.5.")

G4 = "⑧ Strategies · Off / On / Validated ✓"
O3 = "On"
s01 = input.string(O3, "01 Trend baseline EMA50/200 + ADX",   options = ["Off", "On", "Validated ✓"], group = G4)
s02 = input.string(O3, "02 Multi-horizon MA ensemble",        options = ["Off", "On", "Validated ✓"], group = G4)
s03 = input.string(O3, "03 Donchian breakout",                options = ["Off", "On", "Validated ✓"], group = G4)
s04 = input.string(O3, "04 Volatility-managed momentum",      options = ["Off", "On", "Validated ✓"], group = G4)
s05 = input.string(O3, "05 Trend pullback (NFI modules)",     options = ["Off", "On", "Validated ✓"], group = G4)
s06 = input.string(O3, "06 SMA offset",                       options = ["Off", "On", "Validated ✓"], group = G4)
s07 = input.string(O3, "07 BinCluc Bollinger dip",            options = ["Off", "On", "Validated ✓"], group = G4)
s08 = input.string(O3, "08 Elliot EWO offset",                options = ["Off", "On", "Validated ✓"], group = G4)
s09 = input.string(O3, "09 Confluence score",                 options = ["Off", "On", "Validated ✓"], group = G4)
s10 = input.string(O3, "10 EMA cross",                        options = ["Off", "On", "Validated ✓"], group = G4)
s11 = input.string(O3, "11 ICT liquidity sweep + FVG",        options = ["Off", "On", "Validated ✓"], group = G4)
s12 = input.string(O3, "12 Deep drawdown reclaim",            options = ["Off", "On", "Validated ✓"], group = G4)
s13 = input.string(O3, "13 Double / triple bottom",           options = ["Off", "On", "Validated ✓"], group = G4)
s14 = input.string(O3, "14 Inverse head & shoulders",         options = ["Off", "On", "Validated ✓"], group = G4)
s15 = input.string(O3, "15 Range breakout",                   options = ["Off", "On", "Validated ✓"], group = G4)
s16 = input.string(O3, "16 Range support",                    options = ["Off", "On", "Validated ✓"], group = G4)
s17 = input.string(O3, "17 Bull flag / pennant",              options = ["Off", "On", "Validated ✓"], group = G4)
s18 = input.string(O3, "18 Triangle / falling wedge",         options = ["Off", "On", "Validated ✓"], group = G4)
s19 = input.string(O3, "19 Rounding bottom / cup",            options = ["Off", "On", "Validated ✓"], group = G4)
s20 = input.string(O3, "20 V-bottom reclaim",                 options = ["Off", "On", "Validated ✓"], group = G4)
s21 = input.string(O3, "21 Trendline break",                  options = ["Off", "On", "Validated ✓"], group = G4)
s22 = input.string(O3, "22 Channel bounce",                   options = ["Off", "On", "Validated ✓"], group = G4)
s23 = input.string(O3, "23 Candle at a key level",            options = ["Off", "On", "Validated ✓"], group = G4)
s24 = input.string(O3, "24 SMC sweep → BOS → order block",    options = ["Off", "On", "Validated ✓"], group = G4)
s25 = input.string(O3, "25 RSI failure swing",                options = ["Off", "On", "Validated ✓"], group = G4)
s26 = input.string(O3, "26 Squeeze breakout",                 options = ["Off", "On", "Validated ✓"], group = G4)
s27 = input.string(O3, "27 VWAP reversion",                   options = ["Off", "On", "Validated ✓"], group = G4)

// ================================================================================================== THEME
bgLum   = color.r(chart.bg_color) * 0.299 + color.g(chart.bg_color) * 0.587 + color.b(chart.bg_color) * 0.114
dark    = theme == "Dark" or (theme == "Auto" and bgLum < 128)
C_PANEL = dark ? color.new(#131722, 4) : color.new(#ffffff, 2)
C_HEAD  = dark ? #1e222d : #eef1f6
C_ROWA  = dark ? color.new(#1e222d, 55) : color.new(#f5f7fa, 0)
C_TXT   = dark ? #d1d4dc : #131722
C_MUTE  = dark ? #787b86 : #6a6d78
C_LINE  = dark ? #2a2e39 : #d1d4dc
C_NEUT  = dark ? #9598a1 : #6a6d78
TXT     = boardTxt == "Tiny" ? size.tiny : boardTxt == "Normal" ? size.normal : size.small
POS     = boardPosIn == "Top left" ? position.top_left : boardPosIn == "Top center" ? position.top_center :
          boardPosIn == "Middle right" ? position.middle_right : boardPosIn == "Middle left" ? position.middle_left :
          boardPosIn == "Bottom right" ? position.bottom_right : boardPosIn == "Bottom left" ? position.bottom_left :
          boardPosIn == "Bottom center" ? position.bottom_center : position.top_right
f_tint(color c) => color.new(c, dark ? 70 : 82)
f_scoreCol(float s) => s >= 65 ? colUp : s >= 40 ? colSetup : colDn          // checks: pass ≥ 65, warn ≥ 40, fail
f_verdictCol(string v) => v == "FAVORABLE" ? colUp : v == "WATCHLIST" ? colSetup : v == "AVOID" ? colDn : C_NEUT

// ============================================================================== CORE SERIES (indicators.add_all)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)
rsi    = ta.rsi(close, 14)
atr    = ta.atr(14)
atrPct = atr / close
[diPlus, diMinus, adx] = ta.dmi(14, 14)
[macdLine, macdSig, macdHist] = ta.macd(close, 12, 26, 9)
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2)
bbw      = (bbUp - bbLo) / bbMid                                  // pandas-ta BBB / 100
volSma30 = ta.sma(volume, 30)
volRatio = volSma30 > 0 ? volume / volSma30 : na                  // base volume (quote volume is not on TradingView)
sma20    = ta.sma(close, 20)
ewo      = (ta.ema(close, 5) - ta.ema(close, 35)) / close * 100    // Elliott wave oscillator, %
qv       = volume * hlc3                                           // ≈ quote volume per candle
tfSec      = timeframe.in_seconds()
barsPerDay = math.max(1, math.round(86400.0 / tfSec))
yrBars     = math.min(math.round(31536000.0 / tfSec), 1500)        // trailing year, capped for speed
qv24       = math.sum(qv, barsPerDay)                              // ≈ 24h quote volume
liquidityOk = qv24 >= minQv24
isBtc      = syminfo.basecurrency == "BTC"
max_bars_back(high, 500)
max_bars_back(low, 500)
max_bars_back(close, 500)
max_bars_back(open, 500)
max_bars_back(atr, 500)
max_bars_back(atrPct, 1500)                             // ta.percentrank over up to 1500 candles
max_bars_back(rsi, 500)
max_bars_back(ema50, 500)
max_bars_back(bbw, 500)

// ===================================================== MULTI-TIMEFRAME CONTEXT (last CLOSED higher-TF candle)
// A higher timeframe is read one candle back with lookahead_on (= its last closed candle, never the forming one);
// the same or a lower timeframe is read as-is. Exactly what regime.align() does in the bot.
off4h = tfSec < 14400 ? 1 : 0
off1h = tfSec < 3600 ? 1 : 0
offD  = tfSec < 86400 ? 1 : 0
la4h  = tfSec < 14400 ? barmerge.lookahead_on : barmerge.lookahead_off
la1h  = tfSec < 3600 ? barmerge.lookahead_on : barmerge.lookahead_off
laD   = tfSec < 86400 ? barmerge.lookahead_on : barmerge.lookahead_off
htfStr = tfSec <= 900 ? "60" : tfSec <= 3600 ? "240" : tfSec <= 14400 ? "D" : tfSec <= 86400 ? "W" : "M"

// checks._tf_trend: +25 close > EMA50 · +25 EMA50 > long EMA · +20 EMA50 rising (5 bars) · +30 ADX ≥ 20 with +DI (+12 if ADX < 20)
f_tfPts(simple int off) =>
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    lng = na(e200) ? e50 : e200
    [dp, dm, ax] = ta.dmi(14, 14)
    pts = (close > e50 ? 25.0 : 0.0) + (e50 > lng ? 25.0 : 0.0) + (e50 > e50[5] ? 20.0 : 0.0) + (ax >= 20 and dp > dm ? 30.0 : ax < 20 ? 12.0 : 0.0)
    pts[off]
// the coin's daily candles: RSI, ATR %, 90-day max drawdown, 30/90-day return, 7d/30d volume, 7-day change
f_dCoin(simple int off) =>
    r = ta.rsi(close, 14)
    ap = ta.atr(14) / close
    float pk = na
    float mdd = 0.0
    for i = 89 to 0
        c = close[i]
        if not na(c)
            pk := na(pk) ? c : math.max(pk, c)
            mdd := math.min(mdd, c / pk - 1)
    n90 = math.min(90, bar_index)
    r30 = close / close[30] - 1
    r90 = close / close[n90] - 1
    q = volume * hlc3
    vr = ta.sma(q, 7) / ta.sma(q, 30)
    p7 = close / close[7] - 1
    [r[off], ap[off], mdd[off], r30[off], r90[off], vr[off], p7[off]]
// BTC daily: risk-on (close > long EMA and EMA20 > EMA50), returns, 7-day change, break of the 30-day low close
f_dBtc(simple int off) =>
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    lng = na(e200) ? e50 : e200
    on = close > lng and e20 > e50 ? 1.0 : 0.0
    n90 = math.min(90, bar_index)
    r30 = close / close[30] - 1
    r90 = close / close[n90] - 1
    c7 = close / close[7] - 1
    sup = close < ta.lowest(close, 30)[1] ? 1.0 : 0.0
    [on[off], r30[off], r90[off], c7[off], sup[off]]

[htfClose, htfEma200] = request.security(syminfo.tickerid, htfStr, [close[1], ta.ema(close, 200)[1]], lookahead = barmerge.lookahead_on)
[dRsi, dAtrPct, dMdd90, dRet30, dRet90, dVr7, dP7] = request.security(syminfo.tickerid, "D", f_dCoin(offD), lookahead = laD)
[bOnF, bRet30, bRet90, bChg7, bSup30] = request.security(btcSym, "D", f_dBtc(offD), lookahead = laD)
btcClose = request.security(btcSym, timeframe.period, close)
ptsD = request.security(syminfo.tickerid, "D", f_tfPts(offD), lookahead = laD)
pts4 = request.security(syminfo.tickerid, "240", f_tfPts(off4h), lookahead = la4h)
pts1 = request.security(syminfo.tickerid, "60", f_tfPts(off1h), lookahead = la1h)
btcOnRaw = na(bOnF) or bOnF == 1.0                                // missing BTC data counts as risk-on (as in the bot)
btcOn    = not useBtc or btcOnRaw

// =================================================================================== COIN REGIME (regime.classify)
er      = math.abs(close - close[20]) / math.max(math.sum(math.abs(close - close[1]), 20), 1e-12)   // Kaufman efficiency
trendSt = adx >= 22 or er >= 0.35 ? "trend" : adx < 18 and er < 0.25 ? "range" : "transition"
dirUp   = close > ema50
volRank = ta.percentrank(atrPct, yrBars) / 100.0
volSt   = volRank >= 0.8 ? "high" : volRank <= 0.2 ? "low" : "normal"
highVol = volSt == "high"
regTrend = liquidityOk and trendSt != "range" and dirUp and btcOn            // strategies that need "trend"
regPull  = liquidityOk and btcOn and not highVol                            // "trend_pullback" / "momentum" / "dip"
regRange = liquidityOk and trendSt == "range" and not highVol               // "range"
regAny   = liquidityOk                                                      // "any"

// ===================================================================== MARKET LAYER (market.classify + market.gate)
f_btc4h(simple int off) =>                              // BTC 4h: above EMA200 with bullish pivot structure, event volatility, chop, reclaim
    e200 = ta.ema(close, 200)
    ph = ta.pivothigh(high, 3, 3)
    pl = ta.pivotlow(low, 3, 3)
    h0 = ta.valuewhen(not na(ph), ph, 0)
    h1 = ta.valuewhen(not na(ph), ph, 1)
    l0 = ta.valuewhen(not na(pl), pl, 0)
    l1 = ta.valuewhen(not na(pl), pl, 1)
    bull = close > e200 and h0 > h1 and l0 > l1 ? 1.0 : 0.0
    ap = ta.atr(14) / close
    hv = ap >= ta.percentile_nearest_rank(ap, 500, 95) or math.abs(close / close[6] - 1) > 0.08 ? 1.0 : 0.0
    [dp, dm, ax] = ta.dmi(14, 14)
    adxLow = ax < 18 ? 1.0 : 0.0
    below = math.sum(close < e200 ? 1.0 : 0.0, 30)            // stateful calls stay outside and / or (v6 is lazy)
    recl = ta.highest(close - e200, 30) > 0 and below[30] / 30 > 0.5 ? 1.0 : 0.0
    [bull[off], hv[off], adxLow[off], recl[off]]
f_ab200(simple int off) =>
    v = close > ta.ema(close, 200) ? 1.0 : 0.0
    v[off]
f_slDn(simple int off) =>                               // EMA20 below its value 5 candles ago
    e = ta.ema(close, 20)
    v = e < e[5] ? 1.0 : 0.0
    v[off]
f_t34h(simple int off) =>                               // TOTAL3 4h: above EMA200; new high over the prior 50 candles on 1.2x volume
    ab = close > ta.ema(close, 200) ? 1.0 : 0.0
    hi6 = ta.highest(close, 6)
    hi50 = ta.highest(close, 50)
    v6 = ta.sma(volume, 6)
    v54 = ta.sma(volume, 54)
    brk = hi6 > hi50[6] and v6 > 1.2 * v54[6] ? 1.0 : 0.0
    [ab[off], brk[off]]
f_c7sup(simple int off) =>                              // 7-candle change; close under the prior 30-candle low close
    c7 = close / close[7] - 1
    sup = close < ta.lowest(close, 30)[1] ? 1.0 : 0.0
    [c7[off], sup[off]]
f_usdtD(simple int off) =>                              // EMA20 falling; close above the prior 30-candle high close
    e = ta.ema(close, 20)
    dn = e < e[5] ? 1.0 : 0.0
    up30 = close > ta.highest(close, 30)[1] ? 1.0 : 0.0
    [dn[off], up30[off]]
f_bull50(simple int off) =>                             // close above a rising EMA50
    e = ta.ema(close, 50)
    v = close > e and e > e[5] ? 1.0 : 0.0
    v[off]
f_dxy(simple int off) =>                                // market.trend(s, 50), broke_higher(60), 20-candle change
    e50 = ta.ema(close, 50)
    e20 = ta.ema(close, 20)
    ab = close > e50 ? 1.0 : 0.0
    dn = e20 < e20[5] ? 1.0 : 0.0
    hi60 = close > ta.highest(close, 60)[1] ? 1.0 : 0.0
    c20 = close / close[20] - 1
    [ab[off], dn[off], hi60[off], c20[off]]
f_ab50(simple int off) =>
    v = close > ta.ema(close, 50) ? 1.0 : 0.0
    v[off]
f_cl(simple int off) =>
    close[off]

[mBtcBull, mHv, mAdxLow, mRecl] = request.security(btcSym, "240", f_btc4h(off4h), lookahead = la4h)
mTotAb  = request.security(symTot, "240", f_ab200(off4h), lookahead = la4h, ignore_invalid_symbol = true)
mTot2Ab = request.security(symTot2, "240", f_ab200(off4h), lookahead = la4h, ignore_invalid_symbol = true)
[mT3Ab, mT3Brk] = request.security(symTot3, "240", f_t34h(off4h), lookahead = la4h, ignore_invalid_symbol = true)
mBdDn4  = request.security(symBtcD, "240", f_slDn(off4h), lookahead = la4h, ignore_invalid_symbol = true)
mUdDn4  = request.security(symUsdtD, "240", f_slDn(off4h), lookahead = la4h, ignore_invalid_symbol = true)
[mTotC7, mTotSup] = request.security(symTot, "D", f_c7sup(offD), lookahead = laD, ignore_invalid_symbol = true)
[mT3C7, mT3Sup] = request.security(symTot3, "D", f_c7sup(offD), lookahead = laD, ignore_invalid_symbol = true)
mBdDnD  = request.security(symBtcD, "D", f_slDn(offD), lookahead = laD, ignore_invalid_symbol = true)
[mUdDnD, mUdUp30] = request.security(symUsdtD, "D", f_usdtD(offD), lookahead = laD, ignore_invalid_symbol = true)
mEthBull = request.security(symEthBtc, "D", f_bull50(offD), lookahead = laD, ignore_invalid_symbol = true)
[mDxyAb, mDxyDn, mDxyHi60, mDxyC20] = request.security(symDxy, "D", f_dxy(offD), lookahead = laD, ignore_invalid_symbol = true)
mVix    = request.security(symVix, "D", f_cl(offD), lookahead = laD, ignore_invalid_symbol = true)
mNdxAb  = request.security(symNdx, "D", f_ab50(offD), lookahead = laD, ignore_invalid_symbol = true)
mCoinBtc = request.security("BINANCE:" + syminfo.basecurrency + "BTC", "D", f_bull50(offD), lookahead = laD, ignore_invalid_symbol = true)

mAvail    = useMkt and not na(mTotAb)
btc7      = nz(bChg7) * 100
tot7      = nz(mTotC7) * 100
t37       = nz(mT3C7) * 100
btcBull4  = mBtcBull == 1
btcdFall  = mBdDn4 == 1 and mBdDnD == 1
btcdRise  = mBdDn4 == 0 and mBdDnD == 0
usdtFall  = mUdDn4 == 1 and mUdDnD == 1
usdtRise  = mUdDn4 == 0 and mUdDnD == 0
t3Above   = mT3Ab == 1
dxyOk     = mDxyAb == 0 or mDxyDn == 1
dxyBreak  = mDxyHi60 == 1 and nz(mDxyC20) * 100 > 2
liqHigh   = qv24 >= 20000000
btcSup    = bSup30 == 1
t3Sup     = mT3Sup == 1
usdtUp    = mUdUp30 == 1
coinBtcOk = mCoinBtc == 1 and not isBtc
altScore  = math.max(0.0, math.min(100.0, (btcBull4 ? 15.0 : 0) + (mTot2Ab == 1 ? 10 : 0) + (t3Above ? 15 : 0) +
     (mT3Brk == 1 ? 10 : 0) + (btcdFall ? 10 : 0) + (usdtFall ? 10 : 0) + (mEthBull == 1 ? 10 : 0) + (dxyOk ? 5 : 0) +
     (coinBtcOk ? 10 : 0) + (liqHigh ? 5 : 0) - (btcSup ? 25 : 0) - (t3Sup ? 20 : 0) - (usdtUp ? 15 : 0) - (dxyBreak ? 10 : 0)))
btcScoreM = math.max(0.0, math.min(100.0, (btcBull4 ? 30.0 : 0) + (mTotAb == 1 ? 15 : 0) + (usdtFall ? 20 : 0) + (dxyOk ? 10 : 0) +
     (mVix < 20 ? 10 : 0) + (mNdxAb == 1 ? 10 : 0) + (liqHigh ? 5 : 0) - (btcSup ? 25 : 0) - (usdtUp ? 15 : 0) - (dxyBreak ? 10 : 0)))
hvEvent   = mHv == 1 or mVix > 35
chop      = mAdxLow == 1 and math.abs(btc7) < 3
mRegime   = not mAvail ? "n/a" : hvEvent ? "High-volatility event" : btc7 < -10 and tot7 < -10 ? "BTC selloff" :
     usdtRise and tot7 < 0 ? "Risk-off / stablecoin rotation" : btcdFall and usdtFall and t37 > btc7 + 3 ? "Altcoin rotation" :
     btcBull4 and t3Above and not btcdRise and usdtFall ? "Broad risk-on" : btcBull4 and btcdRise and t37 < btc7 ? "BTC-led rally" :
     mRecl == 1 and not t3Above ? "BTC recovery, alts weak" : chop ? "Range / chop" : "Mixed"
mBehave   = mRegime == "High-volatility event" ? "Pause automatic entries; every signal needs manual approval." :
     mRegime == "BTC selloff" ? "Disable altcoin longs; watch liquidation and volatility." :
     mRegime == "Risk-off / stablecoin rotation" ? "BTC longs only, and only fully validated ones." :
     mRegime == "Altcoin rotation" ? "Selective ETH / alt longs, ranked by relative strength." :
     mRegime == "Broad risk-on" ? "BTC, ETH and high-quality alt long setups are enabled." :
     mRegime == "BTC-led rally" ? "Prefer BTC; be selective with alts." :
     mRegime == "BTC recovery, alts weak" ? "Trade BTC carefully; wait for alt confirmation." :
     mRegime == "Range / chop" ? "Range, dip and mean-reversion modules only; no breakout / trend entries." :
     mRegime == "Mixed" ? "No dominant regime; rely on per-strategy validation and the eligibility score." : "Market layer off or no data."
mktScore  = isBtc ? btcScoreM : altScore
f_item(bool ok, int pts, string txt) => ok ? (pts > 0 ? "+" : "") + str.tostring(pts) + "  " + txt + "\n" : ""
mItems    = isBtc ? f_item(btcBull4, 30, "BTC above 4H EMA200, bullish structure") + f_item(mTotAb == 1, 15, "TOTAL above 4H EMA200") +
     f_item(usdtFall, 20, "USDT.D falling on 4H and 1D") + f_item(dxyOk, 10, "Dollar falling or below trend") +
     f_item(mVix < 20, 10, "VIX below 20") + f_item(mNdxAb == 1, 10, "Nasdaq 100 above trend") + f_item(liqHigh, 5, "High liquidity") +
     f_item(btcSup, -25, "BTC broke its 30-day low") + f_item(usdtUp, -15, "USDT.D broke higher") + f_item(dxyBreak, -10, "Dollar broke higher strongly") :
     f_item(btcBull4, 15, "BTC above 4H EMA200, bullish structure") + f_item(mTot2Ab == 1, 10, "TOTAL2 above 4H EMA200") +
     f_item(t3Above, 15, "TOTAL3 above 4H EMA200") + f_item(mT3Brk == 1, 10, "TOTAL3 broke resistance on volume") +
     f_item(btcdFall, 10, "BTC.D falling on 4H and 1D") + f_item(usdtFall, 10, "USDT.D falling on 4H and 1D") +
     f_item(mEthBull == 1, 10, "ETH/BTC bullish") + f_item(dxyOk, 5, "Dollar falling or below trend") +
     f_item(coinBtcOk, 10, "Coin/BTC pair bullish") + f_item(liqHigh, 5, "High liquidity") + f_item(btcSup, -25, "BTC broke its 30-day low") +
     f_item(t3Sup, -20, "TOTAL3 broke support") + f_item(usdtUp, -15, "USDT.D broke higher") + f_item(dxyBreak, -10, "Dollar broke higher strongly")

// ====================================================================== PIVOTS (patterns.pivots, K = 3 candles)
// A pivot is the single highest high / lowest low of a 7-candle window (ties do not count). Known 3 candles later.
K = 3
var int[]   phI = array.new<int>()
var float[] phV = array.new<float>()
var int[]   plI = array.new<int>()
var float[] plV = array.new<float>()
f_isPivot(bool isHigh) =>                                     // the candle K bars ago is the UNIQUE extreme of 2K+1
    bool ok = bar_index >= 2 * K
    if ok
        c0 = isHigh ? high[K] : low[K]
        for j = 0 to 2 * K
            if j != K and (isHigh ? high[j] >= c0 : low[j] <= c0)
                ok := false
                break
    ok
newPH = f_isPivot(true)
newPL = f_isPivot(false)
phNew = high[K]
plNew = low[K]
if newPH
    array.push(phI, bar_index - K)
    array.push(phV, phNew)
    if array.size(phI) > 80
        array.shift(phI)
        array.shift(phV)
if newPL
    array.push(plI, bar_index - K)
    array.push(plV, plNew)
    if array.size(plI) > 80
        array.shift(plI)
        array.shift(plV)
nPH = array.size(phI)
nPL = array.size(plI)
lastPhI = nPH > 0 ? array.get(phI, nPH - 1) : -1
lastPhV = nPH > 0 ? array.get(phV, nPH - 1) : na
lastPlI = nPL > 0 ? array.get(plI, nPL - 1) : -1
lastPlV = nPL > 0 ? array.get(plV, nPL - 1) : na
// market structure: two higher highs and higher lows = bullish, two lower = bearish
structure = nPH >= 2 and nPL >= 2 ?
     (array.get(phV, nPH - 1) > array.get(phV, nPH - 2) and array.get(plV, nPL - 1) > array.get(plV, nPL - 2) ? "bullish" :
      array.get(phV, nPH - 1) < array.get(phV, nPH - 2) and array.get(plV, nPL - 1) < array.get(plV, nPL - 2) ? "bearish" : "mixed") : "unknown"

// ------------------------------------------------------------------------------------------------- helpers
f_off(int i) => math.min(math.max(bar_index - i, 0), 480)              // history offset of a bar index (capped)
f_tol(int i) => math.min(math.max(0.5 * atrPct[f_off(i)], 0.005), 0.015)   // equal-level tolerance 0.5 %-1.5 %
f_hh(int a, int b) =>
    float m = na
    if b >= a
        for i = a to b
            m := na(m) ? high[f_off(i)] : math.max(m, high[f_off(i)])
    m
f_ll(int a, int b) =>
    float m = na
    if b >= a
        for i = a to b
            m := na(m) ? low[f_off(i)] : math.min(m, low[f_off(i)])
    m
f_closeOutside(int a, int b, float lo_, float hi_) =>
    bool out = false
    if b >= a
        for i = a to b
            c = close[f_off(i)]
            if c > hi_ or c < lo_
                out := true
                break
    out
f_priorDown(int i) =>                                                  // ≥ 3 ATR off the 30-candle high, under EMA50
    o = f_off(i)
    (f_hh(math.max(i - 30, bar_index - 480), i) - low[o]) >= 3 * atr[o] and close[o] <= ema50[o]
f_priorUp(int i) =>                                                    // ≥ 3 ATR above the 30-candle low, over EMA50
    o = f_off(i)
    (high[o] - f_ll(math.max(i - 30, bar_index - 480), i)) >= 3 * atr[o] and close[o] >= ema50[o]
f_maxPhBetween(int a, int b) =>                                        // highest pivot high strictly inside (a, b)
    int bi = -1
    float bv = na
    if nPH > 0
        for j = 0 to nPH - 1
            idx = array.get(phI, j)
            if idx > a and idx < b and (na(bv) or array.get(phV, j) > bv)
                bi := idx
                bv := array.get(phV, j)
    [bi, bv]
f_minPlBetween(int a, int b) =>                                        // lowest pivot low strictly inside (a, b)
    int bi = -1
    float bv = na
    if nPL > 0
        for j = 0 to nPL - 1
            idx = array.get(plI, j)
            if idx > a and idx < b and (na(bv) or array.get(plV, j) < bv)
                bi := idx
                bv := array.get(plV, j)
    [bi, bv]
f_lastPlBetween(int a, int b) =>                                       // newest pivot low strictly inside (a, b)
    int bi = -1
    float bv = na
    if nPL > 0
        for j = 0 to nPL - 1
            idx = array.get(plI, j)
            if idx > a and idx < b
                bi := idx
                bv := array.get(plV, j)
    [bi, bv]
f_fit3(float[] xs, float[] ys) =>                                      // least squares: slope, intercept, max residual
    n = array.size(xs)
    float sx = 0.0
    float sy = 0.0
    float sxx = 0.0
    float sxy = 0.0
    for j = 0 to n - 1
        sx += array.get(xs, j)
        sy += array.get(ys, j)
        sxx += array.get(xs, j) * array.get(xs, j)
        sxy += array.get(xs, j) * array.get(ys, j)
    den = n * sxx - sx * sx
    sl = den != 0 ? (n * sxy - sx * sy) / den : 0.0
    ic = (sy - sl * sx) / n
    float rmax = 0.0
    for j = 0 to n - 1
        rmax := math.max(rmax, math.abs(array.get(ys, j) - (sl * array.get(xs, j) + ic)))
    [sl, ic, rmax]

// --------------------------------------------------------------- breakout triggers (patterns.trigger)
// Bullish: the FIRST close above the level decides. It must carry ≥ vmult × average volume and (needBos) close above the
// last confirmed pivot high made after the pattern started, and the plan must offer ≥ minRR. A close at or under the
// stop first, or the expiry, cancels the setup.
f_trig(bool act, float lvl, float stp0, float tgt0, int start, int expi, bool needBos, float vmult) =>
    bool fired = false
    bool keep = act
    float stp = na
    float tgt = na
    float lim = na
    if act
        if close <= stp0 or bar_index > expi
            keep := false
        else if close > lvl
            keep := false
            volOk = not na(volRatio) and volRatio >= vmult
            bosOk = not needBos or lastPhI < 0 or lastPhI <= start or bar_index - lastPhI > 450 or close > lastPhV
            if volOk and bosOk
                ref = patEntry == "retest" ? lvl + 0.1 * atr : close
                stpAdj = patStop == "tight" ? math.max(stp0, lvl - 1.5 * atr) : stp0
                tgtAdj = na(tgt0) ? ref + 2 * (ref - stpAdj) : tgt0
                riskAdj = ref - stpAdj
                rr = riskAdj > 0 ? (tgtAdj - ref) / riskAdj : 0.0
                if rr >= minRR
                    fired := true
                    stp := stpAdj
                    tgt := tgtAdj
                    lim := patEntry == "retest" ? ref : na
    [fired, keep, stp, tgt, lim]
// Bearish (long blockers): the first close under the level with ≥ vmult × volume; a close at or above the stop cancels.
f_trigBear(bool act, float lvl, float stp0, int expi, float vmult) =>
    bool fired = false
    bool keep = act
    if act
        if close >= stp0 or bar_index > expi
            keep := false
        else if close < lvl
            keep := false
            fired := not na(volRatio) and volRatio >= vmult
    [fired, keep]

// ============================================================================== 01-12  RULE STRATEGIES
// 01 Trend baseline (EMA50/200 + ADX) — the Freqtrade CoinAuditTrend rules
e01 = close > ema50 and ema50 > ema200 and rsi > 50 and adx > adxMin and diPlus > diMinus and btcOn
x01 = close < ema50
// 02 Multi-horizon MA ensemble: one vote per SMA (20/50/100) that price is above AND that is rising (3 bars)
smaA = ta.sma(close, 20)
smaB = ta.sma(close, 50)
smaC = ta.sma(close, 100)
maVote = (close > smaA and smaA > smaA[3] ? 1 : 0) + (close > smaB and smaB > smaB[3] ? 1 : 0) + (close > smaC and smaC > smaC[3] ? 1 : 0)
e02 = maVote >= maVotes
x02 = maVote <= 1
// 03 Donchian breakout: close above the prior N-bar high; exit under the prior N/2-bar low
e03 = close > ta.highest(high, donN)[1]
x03 = close < ta.lowest(low, math.max(5, math.floor(donN / 2)))[1]
// 04 Volatility-managed momentum: L-bar return / (30-bar st.dev × √L), beating BTC, outside the top volatility decile
mom      = close / close[momL] - 1
btcMom   = btcClose / btcClose[momL] - 1
rv       = ta.stdev(close / close[1] - 1, 30)
momScore = rv > 0 ? mom / (rv * math.sqrt(momL)) : 0.0
relMom   = isBtc ? 1e-9 : mom - btcMom
crash    = rv > ta.percentile_nearest_rank(rv, math.min(yrBars, 1000), 90)
e04 = momScore > momMin and relMom > 0 and not crash
x04 = mom < 0 or relMom < 0 or crash
// 05 Trend pullback (NFI-inspired modules): HTF trend · BTC · safe dip · pump guard · volume · EWO guard
pbTrend = na(htfEma200) ? close > ema200 : htfClose > htfEma200
pbDip   = rsi < pbRsi and (ema20 - close) / atr >= 1.0
rng24   = ta.highest(high, 24) / ta.lowest(low, 24) - 1
pumpOk  = rng24 < 8 * atrPct
pbVol   = volRatio > 0.7                                     // the bot also wants taker-buy share > 42 % (not on TV)
ewoOk   = ewo > ta.percentile_nearest_rank(ewo, 200, 5)
e05 = pbTrend and btcOn and pbDip and pumpOk and pbVol and ewoOk
x05 = close > ema20 or rsi > 65
// 06 SMA offset (NotAnotherSMAOffset, HO/Protect variant)
sma14 = ta.sma(close, 14)
rsi4  = ta.rsi(close, 4)
e06 = ((close < sma14 * smaOff and ewo > smaEwo and rsi < 50 and rsi4 < 35) or (close < sma14 * smaOff and ewo < -8 and rsi4 < 25)) and btcOn and pumpOk
x06 = close > sma20 * 1.01 and rsi > 50
// 07 BinCluc: BinHV45 (break under the prior lower BB40 after a big red candle with a small tail) or ClucMay (under lower BB20)
[mid40, up40, lo40] = ta.bb(close, 40, 2)
bbDelta = math.abs(mid40 - lo40)
binh    = lo40[1] > 0 and bbDelta > close * 0.008 and math.abs(close - close[1]) > close * 0.0175 and math.abs(close - low) < bbDelta * 0.25 and close < lo40[1] and close <= close[1]
cluc    = close < ema50 and close < clucMult * bbLo and volume < volSma30 * 20
e07 = (binh or cluc) and btcOn
x07 = close > bbMid
// 08 ElliotV-style EWO offset
ema17 = ta.ema(close, 17)
ema49 = ta.ema(close, 49)
e08 = ((close < ema17 * ellOff and ewo > ellEwo and rsi < 65) or (close < ema17 * ellOff and ewo < -19)) and btcOn
x08 = close > ema49 * 1.006
// 09 Confluence score (6 parts)
confScore = (ema20 > ema50 and ema50 > ema200 ? 1 : 0) + (rsi >= 50 and rsi <= 70 ? 1 : 0) + (adx > 20 and diPlus > diMinus ? 1 : 0) +
     (volRatio > 1.2 ? 1 : 0) + (close > sma20 and bbw > bbw[5] ? 1 : 0) + (macdHist > 0 and macdHist > macdHist[1] ? 1 : 0)
e09 = confScore >= confK and btcOn
x09 = confScore <= 2
// 10 EMA cross (btc-strategy-lab winner; its funding filter has no data on TradingView)
emaF = ta.ema(close, emaFast)
emaS = ta.ema(close, emaSlow)
e10 = emaF > emaS
x10 = emaF < emaS
// 11 ICT liquidity sweep + fair-value gap, limit at 50 % of the displacement
ictSwing  = ta.lowest(low, ictN)[1]
ictSweep  = low < ictSwing and close > ictSwing
ictRecent = ictSweep or ictSweep[1] or ictSweep[2] or ictSweep[3] or ictSweep[4]
e11 = low > high[2] and close > open and ictRecent and btcOn
ictLow6 = ta.lowest(low, 6)
ictLim  = (ictLow6 + high) / 2
ictStop = ictLow6 - 0.1 * atr
// 12 Deep drawdown reclaim (ATH = highest high TradingView loaded)
athDd = close / ta.max(high) - 1
hh20  = ta.highest(high, 20)
e12 = athDd <= -ddLevel and close > hh20[1] and bar_index >= 90

// ============================================================================== 13-22  CHART PATTERNS
// Drawing helpers: one live line / box per armed formation — dashed while armed, solid when it breaks out (kept on
// the chart), deleted when the formation is invalidated or expires.
f_track(line ln, bool keep, bool fired, int x1, float y1, int x2, float y2, color cArmed, color cFired) =>
    line out = ln
    if (keep or fired) and showDraw and not na(y1) and not na(y2)
        if na(out)
            out := line.new(x1, y1, x2, y2, color = cArmed, style = line.style_dashed, width = 1)
        else
            line.set_xy1(out, x1, y1)
            line.set_xy2(out, x2, y2)
        if fired
            line.set_color(out, cFired)
            line.set_style(out, line.style_solid)
            line.set_width(out, 2)
            out := na
    else if not na(out)
        line.delete(out)
        out := na
    out
f_trackBox(box bx, bool keep, bool fired, int x1, float top, int x2, float bot) =>
    box out = bx
    if (keep or fired) and showDraw and not na(top) and not na(bot)
        if na(out)
            out := box.new(x1, top, x2, bot, border_color = color.new(colSetup, 30), border_style = line.style_dashed,
                           bgcolor = color.new(colSetup, 93))
        else
            box.set_lefttop(out, x1, top)
            box.set_rightbottom(out, x2, bot)
        if fired
            box.set_border_color(out, colUp)
            box.set_border_style(out, line.style_solid)
            box.set_bgcolor(out, color.new(colUp, 90))
            out := na
    else if not na(out)
        box.delete(out)
        out := na
    out

// 13 Double / triple bottom (W): 2-3 pivot lows within tolerance, ≥ 5 bars apart, ≤ 150 bars, after a downtrend;
//    neckline = highest pivot high between, ≥ 2 ATR above the lows. Target = neckline + height. Stop under the lows.
f_wbottom(int need) =>
    bool ok = false
    float lvl = na
    float stp = na
    float tgt = na
    int start = 0
    int expi = 0
    if nPL >= need
        p0 = array.get(plI, nPL - need)
        pz = array.get(plI, nPL - 1)
        bool spaced = pz - p0 <= 150
        float vmax = na
        float vmin = na
        float vsum = 0.0
        for j = nPL - need to nPL - 1
            v = array.get(plV, j)
            vmax := na(vmax) ? v : math.max(vmax, v)
            vmin := na(vmin) ? v : math.min(vmin, v)
            vsum += v
            if j > nPL - need and array.get(plI, j) - array.get(plI, j - 1) < 5
                spaced := false
        if spaced and (vmax - vmin) / (vsum / need) <= f_tol(pz)
            [ni, nv] = f_maxPhBetween(p0, pz)
            a = atr[f_off(pz)]
            if ni >= 0 and nv - vmax >= 2 * a and f_priorDown(p0)
                ok := true
                lvl := nv
                stp := vmin - 0.2 * a
                tgt := nv + (nv - vmin)
                start := p0
                expi := pz + K + (pz - p0)
    [ok, lvl, stp, tgt, start, expi]
var bool  dbAct = false
var float dbLvl = na
var float dbStop = na
var float dbTgt = na
var int   dbStart = 0
var int   dbExp = 0
if newPL
    [wOk3, wL3, wS3, wT3, wSt3, wEx3] = f_wbottom(3)
    [wOk2, wL2, wS2, wT2, wSt2, wEx2] = f_wbottom(2)
    if wOk3 or wOk2
        dbAct := true
        dbLvl := wOk3 ? wL3 : wL2
        dbStop := wOk3 ? wS3 : wS2
        dbTgt := wOk3 ? wT3 : wT2
        dbStart := wOk3 ? wSt3 : wSt2
        dbExp := wOk3 ? wEx3 : wEx2
[e13, k13, stop13, tp13, lim13] = f_trig(dbAct, dbLvl, dbStop, dbTgt, dbStart, dbExp, true, volMultIn)
var line ln13 = na
ln13 := f_track(ln13, k13, e13, dbStart, dbLvl, bar_index + 2, dbLvl, colSetup, colUp)
dbAct := k13

// 14 Inverse head & shoulders: head ≥ 0.5 ATR under both shoulders, shoulders level, sloped neckline through the highs
//    between; prior downtrend. Target = neckline + head depth. Stop under the right shoulder.
var bool  ihAct = false
var float ihP0 = na
var int   ihI0 = 0
var float ihSlope = na
var float ihStop = na
var float ihTgt = na
var int   ihStart = 0
var int   ihExp = 0
if newPL and nPL >= 3
    ls = array.get(plI, nPL - 3)
    hd = array.get(plI, nPL - 2)
    rs = array.get(plI, nPL - 1)
    vls = array.get(plV, nPL - 3)
    vhd = array.get(plV, nPL - 2)
    vrs = array.get(plV, nPL - 1)
    aHd = atr[f_off(hd)]
    aRs = atr[f_off(rs)]
    if rs - ls <= 150 and hd - ls >= 3 and rs - hd >= 3 and vhd < math.min(vls, vrs) - 0.5 * aHd and math.abs(vls - vrs) / vhd <= 2 * f_tol(rs)
        [n1i, n1v] = f_maxPhBetween(ls, hd)
        [n2i, n2v] = f_maxPhBetween(hd, rs)
        if n1i >= 0 and n2i >= 0 and math.abs(n2v - n1v) <= 3 * aRs and f_priorDown(ls)
            ihSl = (n2v - n1v) / (n2i - n1i)
            ihAct := true
            ihP0 := n1v
            ihI0 := n1i
            ihSlope := ihSl
            ihStop := vrs - 0.2 * aRs
            ihTgt := n1v + ihSl * (rs + K - n1i) + math.abs(n1v + ihSl * (hd - n1i) - vhd)
            ihStart := ls
            ihExp := rs + K + 25
ihLvl = ihAct ? ihP0 + ihSlope * (bar_index - ihI0) : na
[e14, k14, stop14, tp14, lim14] = f_trig(ihAct, ihLvl, ihStop, ihTgt, ihStart, ihExp, true, volMultIn)
var line ln14 = na
ln14 := f_track(ln14, k14, e14, ihI0, ihP0, bar_index + 2, ihP0 + ihSlope * (bar_index + 2 - ihI0), colSetup, colUp)
ihAct := k14

// 15 / 16 Rectangle: ≥ 2 touches at a flat top and a flat bottom inside 50 bars, height 3-14 ATR, no close outside.
var bool  rbBox = false                                       // a box is known (16 trades inside it)
var bool  rbBrk = false                                       // its breakout setup (15) is armed
var int   rbStart = 0
var int   rbExp = 0
var float rbTop = na
var float rbBot = na
var float rbH = na
var int   rbDone = -1                                         // start bar of a box that already broke out
if newPH or newPL
    float[] hv = array.new<float>()
    float[] lv = array.new<float>()
    int s0 = bar_index
    if nPH > 0
        for j = 0 to nPH - 1
            if array.get(phI, j) >= bar_index - 50
                array.push(hv, array.get(phV, j))
                s0 := math.min(s0, array.get(phI, j))
    if nPL > 0
        for j = 0 to nPL - 1
            if array.get(plI, j) >= bar_index - 50
                array.push(lv, array.get(plV, j))
                s0 := math.min(s0, array.get(plI, j))
    if array.size(hv) >= 2 and array.size(lv) >= 2
        top = array.max(hv)
        bot = array.min(lv)
        th = math.max(f_tol(bar_index) * top, 0.3 * atr)
        int tT = 0
        int tB = 0
        for j = 0 to array.size(hv) - 1
            tT += math.abs(array.get(hv, j) - top) <= th ? 1 : 0
        for j = 0 to array.size(lv) - 1
            tB += math.abs(array.get(lv, j) - bot) <= th ? 1 : 0
        height = top - bot
        if tT >= 2 and tB >= 2 and height >= 3 * atr and height <= 14 * atr and not f_closeOutside(s0, bar_index, bot - 0.5 * atr, top + 0.5 * atr)
            rbBox := true
            rbBrk := true
            rbStart := s0
            rbExp := bar_index + 25
            rbTop := top
            rbBot := bot
            rbH := height
// 15 Range breakout: close above the top with volume; stop mid-range; target top + height
[e15, k15, stop15, tp15, lim15] = f_trig(rbBrk, rbTop, rbBot + 0.5 * rbH, rbTop + rbH, rbStart, rbExp, true, volMultIn)
rbBrk := k15
if e15
    rbDone := rbStart
// 16 Range support: a bullish close (green, higher close) in the bottom zone while the box holds; target just under the top
e16 = false
float stop16 = na
float tp16 = na
if rbBox
    if bar_index > rbExp or close > rbTop + 0.5 * atr or close < rbBot - 0.5 * atr
        rbBox := false
    else if close <= rbBot + rsZone * rbH and close > open and close > close[1] and low >= rbBot - 0.5 * atr
        e16 := true
        stop16 := rbBot - 0.5 * atr
        tp16 := rbTop - 0.1 * rbH
var box bx15 = na
bx15 := f_trackBox(bx15, (rbBox or rbBrk) and rbStart != rbDone, e15, rbStart, rbTop, bar_index + 2, rbBot)

// 17 Bull flag / pennant / high tight flag: a pole (13-bar high ≥ 4 ATR above the 13-bar low), then 3-15 bars that
//    retrace ≤ 50 % without a new high; close above the flag high with volume. Target = flag high + pole.
var int   flT1 = -1
var float flH = na
var float flPole = na
var float flSegH = na
var float flSegL = na
e17 = false
float stop17 = na
float tp17 = na
float lim17 = na
float flLvlNow = na
if flT1 >= 0
    if bar_index > flT1 + 15
        flT1 := -1
    else if bar_index >= flT1 + 3 and not na(flSegH)
        if (flH - flSegL) / flPole > 0.5 or flSegH > flH
            flT1 := -1
        else
            flLvlNow := flSegH
            [ff17, fk17, fs17, ft17, fl17] = f_trig(true, flSegH, flSegL - 0.2 * atr, flSegH + flPole, flT1 - 12, bar_index, false, volMultIn)
            if ff17
                e17 := true
                stop17 := fs17
                tp17 := ft17
                lim17 := fl17
var line ln17 = na
ln17 := f_track(ln17, flT1 >= 0 and not e17 and not na(flLvlNow), e17, flT1, flLvlNow, bar_index + 2, flLvlNow, colSetup, colUp)
if e17
    flT1 := -1
if flT1 >= 0 and bar_index > flT1
    flSegH := na(flSegH) ? high : math.max(flSegH, high)
    flSegL := na(flSegL) ? low : math.min(flSegL, low)
low13 = ta.lowest(low, 13)
if high == ta.highest(high, 13) and (high - low13) >= 4 * atr
    flT1 := bar_index
    flH := high
    flPole := high - low13
    flSegH := na
    flSegL := na

// 18 Converging lines through the last 2-3 pivot highs and lows (fit ≤ 0.6 ATR) inside 60 bars (patterns.converging):
//    ascending / symmetrical triangle and falling wedge break UP (strategy 18); descending / symmetrical triangle and
//    rising wedge break DOWN (bearish blocker); parallel rising lines = ascending channel (strategy 22).
var bool   twAct = false
var string twName = ""
var float  twP0 = na
var int    twI0 = 0
var float  twSlope = na
var float  twLp = na
var float  twLs = na
var float  twStop = na
var float  twTgt = na
var int    twStart = 0
var int    twExp = 0
var bool   bwAct = false
var string bwName = ""
var float  bwP0 = na
var int    bwI0 = 0
var float  bwSlope = na
var float  bwStop = na
var int    bwExp = 0
var bool   chAct = false
var float  chUp = na
var float  chUs = na
var float  chLp = na
var float  chLs = na
var int    chI0 = 0
var int    chStart = 0
var int    chExp = 0
if newPH or newPL
    float[] xs = array.new<float>()
    float[] ys = array.new<float>()
    float[] xl = array.new<float>()
    float[] yl = array.new<float>()
    if nPH > 0
        for j = math.max(0, nPH - 3) to nPH - 1
            if array.get(phI, j) >= bar_index - 60
                array.push(xs, array.get(phI, j))
                array.push(ys, array.get(phV, j))
    if nPL > 0
        for j = math.max(0, nPL - 3) to nPL - 1
            if array.get(plI, j) >= bar_index - 60
                array.push(xl, array.get(plI, j))
                array.push(yl, array.get(plV, j))
    if array.size(xs) >= 2 and array.size(xl) >= 2
        [su, iu, ru] = f_fit3(xs, ys)
        [sl, il, rl] = f_fit3(xl, yl)
        if math.max(ru, rl) <= 0.6 * atr
            start = math.round(math.min(array.get(xs, 0), array.get(xl, 0)))
            upMove = su * (bar_index - start)
            loMove = sl * (bar_index - start)
            wStart = (su * start + iu) - (sl * start + il)
            wNow = (su * bar_index + iu) - (sl * bar_index + il)
            if wNow > 0 and wStart > 0
                contracting = wNow < wStart * 0.85 and bbw <= bbw[f_off(start)]
                isAsc  = contracting and math.abs(upMove) < atr and loMove > atr
                isSym  = contracting and upMove < -atr and loMove > atr
                isDesc = contracting and math.abs(loMove) < atr and upMove < -atr
                isFall = contracting and upMove < 0 and loMove < 0 and su < sl
                isRise = contracting and upMove > 0 and loMove > 0 and sl > su
                isChan = not contracting and math.abs(wNow - wStart) < 0.8 * atr and loMove > atr
                nm = isAsc ? "ascending triangle" : isSym ? "symmetrical triangle" : isDesc ? "descending triangle" :
                     isFall ? "falling wedge" : isRise ? "rising wedge" : isChan ? "ascending channel" : ""
                upNow = su * bar_index + iu
                loNow = sl * bar_index + il
                if nm == "ascending triangle" or nm == "symmetrical triangle" or nm == "falling wedge"
                    twAct := true
                    twName := nm
                    twP0 := upNow
                    twI0 := bar_index
                    twSlope := su
                    twLp := loNow
                    twLs := sl
                    twStop := loNow - 0.2 * atr
                    twTgt := upNow + wStart
                    twStart := start
                    twExp := bar_index + 25
                if nm == "symmetrical triangle" or nm == "descending triangle" or nm == "rising wedge"
                    bwAct := true
                    bwName := nm
                    bwP0 := loNow
                    bwI0 := bar_index
                    bwSlope := sl
                    bwStop := upNow + 0.2 * atr
                    bwExp := bar_index + 25
                if nm == "ascending channel"
                    chAct := true
                    chUp := upNow
                    chUs := su
                    chLp := loNow
                    chLs := sl
                    chI0 := bar_index
                    chStart := start
                    chExp := bar_index + 20
twLvl = twAct ? twP0 + twSlope * (bar_index - twI0) : na
[e18, k18, stop18, tp18, lim18] = f_trig(twAct, twLvl, twStop, twTgt, twStart, twExp, false, volMultIn)
var line ln18 = na
var line ln18b = na
ln18 := f_track(ln18, k18, e18, twStart, twP0 + twSlope * (twStart - twI0), bar_index + 2, twP0 + twSlope * (bar_index + 2 - twI0), colSetup, colUp)
ln18b := f_track(ln18b, k18, e18, twStart, twLp + twLs * (twStart - twI0), bar_index + 2, twLp + twLs * (bar_index + 2 - twI0), color.new(colSetup, 40), color.new(colUp, 40))
twAct := k18

// 19 Rounding bottom (U) and cup & handle (patterns.rounding): a least-squares parabola through the last 60 closes opens
//    upward (R² ≥ 0.7, vertex inside the middle 40 %), the base is ≥ 3 ATR under the left rim and volume dries up in the
//    middle third and comes back in the last. U: buy the close above the left rim (stop = base low, at most 3 ATR; 10
//    candles). Cup & handle: the right side is back within 25 % of the rim and a 4-candle handle holds the top half of
//    the cup on quiet volume; buy the close above the higher rim (stop under the handle; 20 candles). Target rim + depth.
f_quad(int s) =>                                              // parabola through the closes s+60 … s+1 candles ago, x = −1 … 1
    float t0 = 0.0
    float t1 = 0.0
    float t2 = 0.0
    float yy = 0.0
    float s2 = 0.0
    float s4 = 0.0
    y0 = close[s + 1]                                         // shift (the fit's shape does not depend on it)
    for j = 0 to 59
        x = -1.0 + 2.0 * j / 59.0
        y = close[s + 60 - j] - y0
        t0 += y
        t1 += x * y
        t2 += x * x * y
        yy += y * y
        s2 += x * x
        s4 += x * x * x * x
    qa = (t2 - s2 * t0 / 60.0) / (s4 - s2 * s2 / 60.0)
    qb = t1 / s2
    qc = (t0 - qa * s2) / 60.0
    ssTot = yy - t0 * t0 / 60.0
    r2 = ssTot > 0 ? 1.0 - (yy - qa * t2 - qb * t1 - qc * t0) / ssTot : 0.0
    vx = qa != 0 ? -qb / (2.0 * qa) : 9.0
    [qa, r2, vx]
[qa0, r20, vx0] = f_quad(0)                                   // window ending on the previous candle
[qa3, r23, vx3] = f_quad(3)                                   // window ending 4 candles ago (+ a 4-candle handle)
rimL0  = ta.highest(high, 10)[51]
lowW0  = ta.lowest(low, 60)[1]
depth0 = rimL0 - lowW0
vS20   = ta.sma(volume, 20)
vS4    = ta.sma(volume, 4)
uOk    = bar_index > 64 and qa0 > 0 and r20 >= 0.7 and math.abs(vx0) <= 0.4 and depth0 >= 3 * atr[1] and
     vS20[21] < vS20[41] and vS20[1] > vS20[21]
rimL3  = ta.highest(high, 10)[54]
lowW3  = ta.lowest(low, 60)[4]
depth3 = rimL3 - lowW3
right3 = ta.highest(high, 10)[4]
hLow3  = ta.lowest(low, 4)
cupOk  = bar_index > 67 and qa3 > 0 and r23 >= 0.7 and math.abs(vx3) <= 0.4 and depth3 >= 3 * atr[4] and
     vS20[24] < vS20[44] and vS20[4] > vS20[24] and right3 >= rimL3 - 0.25 * depth3 and rimL3 - hLow3 <= 0.5 * depth3 and
     vS4 <= vS20[44]
var bool  ubAct = false
var float ubLvl = na
var float ubStop = na
var float ubTgt = na
var int   ubStart = 0
var int   ubExp = 0
var float ubSeen = na
if uOk and (na(ubSeen) or math.abs(rimL0 - ubSeen) > syminfo.mintick)
    ubSeen := rimL0
    ubAct := true
    ubLvl := rimL0
    ubStop := math.max(lowW0, rimL0 - 3 * atr[1])
    ubTgt := rimL0 + depth0
    ubStart := bar_index - 60
    ubExp := bar_index + 10
var bool  cuAct = false
var float cuLvl = na
var float cuStop = na
var float cuTgt = na
var int   cuStart = 0
var int   cuExp = 0
var float cuSeen = na
cupRim = math.max(rimL3, right3)
if cupOk and (na(cuSeen) or math.abs(cupRim - cuSeen) > syminfo.mintick)
    cuSeen := cupRim
    cuAct := true
    cuLvl := cupRim
    cuStop := hLow3 - 0.2 * atr[4]
    cuTgt := cupRim + depth3
    cuStart := bar_index - 63
    cuExp := bar_index + 17
[eUb, kUb, sUb, tUb, lUb] = f_trig(ubAct, ubLvl, ubStop, ubTgt, ubStart, ubExp, true, volMultIn)
[eCu, kCu, sCu, tCu, lCu] = f_trig(cuAct, cuLvl, cuStop, cuTgt, cuStart, cuExp, true, volMultIn)
e19    = eUb or eCu
stop19 = eUb ? sUb : sCu
tp19   = eUb ? tUb : tCu
lim19  = eUb ? lUb : lCu
var line ln19 = na
var line ln19c = na
ln19 := f_track(ln19, kUb, eUb, ubStart, ubLvl, bar_index + 2, ubLvl, colSetup, colUp)
ln19c := f_track(ln19c, kCu, eCu, cuStart, cuLvl, bar_index + 2, cuLvl, colSetup, colUp)
ubAct := kUb
cuAct := kCu

// 20 V-bottom reclaim: an 11-bar low confirmed by a higher close and higher low, ≥ 6 ATR under a high made ≤ 10 bars
//    earlier; reclaim close above 50 % of the drop with ≥ 1.3× volume and a break of structure. Target = the pre-drop high.
var bool  vbAct = false
var float vbLvl = na
var float vbStop = na
var float vbTgt = na
var int   vbStart = 0
var int   vbExp = 0
var int   vbLast = -100
pOff = 1 - ta.highestbars(high, 11)[1]
if low[1] == ta.lowest(low, 11)[1] and close > close[1] and low > low[1] and high[pOff] - low[1] >= 6 * atr[1] and (bar_index - 1) - vbLast >= 20
    vbAct := true
    vbLvl := low[1] + 0.5 * (high[pOff] - low[1])
    vbStop := low[1] - 0.2 * atr[1]
    vbTgt := high[pOff]
    vbStart := bar_index - pOff
    vbExp := bar_index + 9
    vbLast := bar_index - 1
[e20, k20, stop20, tp20, lim20] = f_trig(vbAct, vbLvl, vbStop, vbTgt, vbStart, vbExp, true, math.max(volMultIn, 1.3))
var line ln20 = na
ln20 := f_track(ln20, k20, e20, vbStart, vbLvl, bar_index + 2, vbLvl, colSetup, colUp)
vbAct := k20

// 21 Downtrend-line break: line through two falling pivot highs ≥ 15 bars apart (≥ 1 ATR lower), never closed above;
//    every later pivot low updates the stop. Close above the line with volume and a break of structure; target 2R.
var bool  tlAct = false
var float tlP0 = na
var int   tlI0 = 0
var float tlSlope = na
var float tlStop = na
var int   tlStart = 0
var int   tlExp = 0
var int   tlP2 = -1
var bool  tlLine = false                                      // the line itself: alive until it expires or breaks
var float tlA2 = na
if newPH and nPH >= 2
    p1 = array.get(phI, nPH - 2)
    p2 = array.get(phI, nPH - 1)
    v1 = array.get(phV, nPH - 2)
    v2 = array.get(phV, nPH - 1)
    a2 = atr[f_off(p2)]
    if p2 - p1 >= 15 and v1 - v2 >= a2
        tlSl = (v2 - v1) / (p2 - p1)
        bool broken = false
        for i = p1 to p2
            if close[f_off(i)] > v1 + tlSl * (i - p1) + 0.1 * a2
                broken := true
                break
        [tqI, tqV] = f_lastPlBetween(p1, p2 + 1)
        if not broken and tqI >= 0
            tlLine := true
            tlA2 := a2
            tlAct := true
            tlP0 := v1
            tlI0 := p1
            tlSlope := tlSl
            tlStop := tqV - 0.2 * a2
            tlStart := p1
            tlExp := p2 + K + 30
            tlP2 := p2
tlNow = tlP0 + tlSlope * (bar_index - tlI0)
if tlLine and (bar_index > tlExp or close > tlNow + 0.1 * tlA2)
    tlLine := false                                           // a close through the line ends it (the trigger still decides this candle)
if tlLine and newPL and lastPlI > tlP2 and lastPlI + K <= tlExp
    tlAct := true                                             // a lower low under the line re-arms it with a new stop
    tlStop := lastPlV - 0.2 * atr[f_off(lastPlI)]
tlLvl = tlAct ? tlNow : na
[e21, k21, stop21, tp21, lim21] = f_trig(tlAct, tlLvl, tlStop, na, tlStart, tlExp, true, volMultIn)
var line ln21 = na
ln21 := f_track(ln21, k21, e21, tlI0, tlP0, bar_index + 2, tlP0 + tlSlope * (bar_index + 2 - tlI0), colSetup, colUp)
tlAct := k21

// 22 Ascending channel bounce: a green candle whose low touches the lower line (within chTouch ATR) and closes above it
e22 = false
float stop22 = na
float tp22 = na
if chAct
    lowLine = chLp + chLs * (bar_index - chI0)
    if bar_index > chExp or close < lowLine - 0.5 * atr
        chAct := false
    else if low <= lowLine + chTouch * atr and close > lowLine and close > open
        e22 := true
        stop22 := lowLine - 0.5 * atr
        tp22 := chUp + chUs * (bar_index - chI0)
var line ln22u = na
var line ln22l = na
ln22u := f_track(ln22u, chAct, false, chStart, chUp + chUs * (chStart - chI0), bar_index + 2, chUp + chUs * (bar_index + 2 - chI0), color.new(colPlan, 30), colUp)
ln22l := f_track(ln22l, chAct, false, chStart, chLp + chLs * (chStart - chI0), bar_index + 2, chLp + chLs * (bar_index + 2 - chI0), color.new(colPlan, 30), colUp)

// ============================================================ BEARISH PATTERNS — long blockers (research only)
// A bearish pattern completing (close under its level with ≥ 1.2× volume) blocks new long approvals for 3 candles.
f_mtop(int need) =>                                          // double / triple top (M)
    bool ok = false
    float lvl = na
    float stp = na
    int start = 0
    int expi = 0
    if nPH >= need
        p0 = array.get(phI, nPH - need)
        pz = array.get(phI, nPH - 1)
        bool spaced = pz - p0 <= 150
        float vmax = na
        float vmin = na
        float vsum = 0.0
        for j = nPH - need to nPH - 1
            v = array.get(phV, j)
            vmax := na(vmax) ? v : math.max(vmax, v)
            vmin := na(vmin) ? v : math.min(vmin, v)
            vsum += v
            if j > nPH - need and array.get(phI, j) - array.get(phI, j - 1) < 5
                spaced := false
        if spaced and (vmax - vmin) / (vsum / need) <= f_tol(pz)
            [ni, nv] = f_minPlBetween(p0, pz)
            a = atr[f_off(pz)]
            if ni >= 0 and vmin - nv >= 2 * a and f_priorUp(p0)
                ok := true
                lvl := nv
                stp := vmax + 0.2 * a
                start := p0
                expi := pz + K + (pz - p0)
    [ok, lvl, stp, start, expi]
var bool  mtAct = false
var float mtLvl = na
var float mtStop = na
var int   mtStart = 0
var int   mtExp = 0
if newPH
    [tOk3, tL3, tS3, tSt3, tEx3] = f_mtop(3)
    [tOk2, tL2, tS2, tSt2, tEx2] = f_mtop(2)
    if tOk3 or tOk2
        mtAct := true
        mtLvl := tOk3 ? tL3 : tL2
        mtStop := tOk3 ? tS3 : tS2
        mtStart := tOk3 ? tSt3 : tSt2
        mtExp := tOk3 ? tEx3 : tEx2
[bF1, bK1] = f_trigBear(mtAct, mtLvl, mtStop, mtExp, volMultIn)
var line lnB1 = na
lnB1 := f_track(lnB1, bK1, bF1, mtStart, mtLvl, bar_index + 2, mtLvl, color.new(colDn, 40), colDn)
mtAct := bK1
// head & shoulders top
var bool  hsAct = false
var float hsP0 = na
var int   hsI0 = 0
var float hsSlope = na
var float hsStop = na
var int   hsExp = 0
if newPH and nPH >= 3
    hls = array.get(phI, nPH - 3)
    hhd = array.get(phI, nPH - 2)
    hrs = array.get(phI, nPH - 1)
    hvls = array.get(phV, nPH - 3)
    hvhd = array.get(phV, nPH - 2)
    hvrs = array.get(phV, nPH - 1)
    if hrs - hls <= 150 and hhd - hls >= 3 and hrs - hhd >= 3 and hvhd > math.max(hvls, hvrs) + 0.5 * atr[f_off(hhd)] and math.abs(hvls - hvrs) / hvhd <= 2 * f_tol(hrs)
        [m1i, m1v] = f_minPlBetween(hls, hhd)
        [m2i, m2v] = f_minPlBetween(hhd, hrs)
        if m1i >= 0 and m2i >= 0 and math.abs(m2v - m1v) <= 3 * atr[f_off(hrs)] and f_priorUp(hls)
            hsAct := true
            hsP0 := m1v
            hsI0 := m1i
            hsSlope := (m2v - m1v) / (m2i - m1i)
            hsStop := hvrs + 0.2 * atr[f_off(hrs)]
            hsExp := hrs + K + 25
hsLvl = hsAct ? hsP0 + hsSlope * (bar_index - hsI0) : na
[bF2, bK2] = f_trigBear(hsAct, hsLvl, hsStop, hsExp, volMultIn)
var line lnB2 = na
lnB2 := f_track(lnB2, bK2, bF2, hsI0, hsP0, bar_index + 2, hsP0 + hsSlope * (bar_index + 2 - hsI0), color.new(colDn, 40), colDn)
hsAct := bK2
// bear flag / pennant: a pole down (13-bar low ≥ 4 ATR under the 13-bar high), 3-15 bars retracing ≤ 50 %
var int   bfT1 = -1
var float bfL = na
var float bfPole = na
var float bfSegH = na
var float bfSegL = na
bF3 = false
if bfT1 >= 0
    if bar_index > bfT1 + 15
        bfT1 := -1
    else if bar_index >= bfT1 + 3 and not na(bfSegL)
        if (bfSegH - bfL) / bfPole > 0.5 or bfSegL < bfL
            bfT1 := -1
        else if close >= bfSegH + 0.2 * atr
            bfT1 := -1
        else if close < bfSegL
            bF3 := not na(volRatio) and volRatio >= volMultIn
            bfT1 := -1
if bfT1 >= 0 and bar_index > bfT1
    bfSegH := na(bfSegH) ? high : math.max(bfSegH, high)
    bfSegL := na(bfSegL) ? low : math.min(bfSegL, low)
high13 = ta.highest(high, 13)
if low == ta.lowest(low, 13) and (high13 - low) >= 4 * atr
    bfT1 := bar_index
    bfL := low
    bfPole := high13 - low
    bfSegH := na
    bfSegL := na
// descending / symmetrical triangle, rising wedge breaking down
bwLvl = bwAct ? bwP0 + bwSlope * (bar_index - bwI0) : na
[bF4, bK4] = f_trigBear(bwAct, bwLvl, bwStop, bwExp, volMultIn)
var line lnB4 = na
lnB4 := f_track(lnB4, bK4, bF4, math.max(0, bwI0 - 20), bwP0 + bwSlope * (math.max(0, bwI0 - 20) - bwI0), bar_index + 2, bwP0 + bwSlope * (bar_index + 2 - bwI0), color.new(colDn, 40), colDn)
bwAct := bK4

// rounding top: the same parabola opening downward, ≥ 3 ATR tall; breaks under the left rim
rimLt  = ta.lowest(low, 10)[51]
highW0 = ta.highest(high, 60)[1]
rtOk   = bar_index > 64 and qa0 < 0 and r20 >= 0.7 and math.abs(vx0) <= 0.4 and highW0 - rimLt >= 3 * atr[1]
var bool  rtAct = false
var float rtLvl = na
var float rtStop = na
var int   rtStart = 0
var int   rtExp = 0
var float rtSeen = na
if rtOk and (na(rtSeen) or math.abs(rimLt - rtSeen) > syminfo.mintick)
    rtSeen := rimLt
    rtAct := true
    rtLvl := rimLt
    rtStop := math.min(highW0, rimLt + 3 * atr[1])
    rtStart := bar_index - 60
    rtExp := bar_index + 10
[bF5, bK5] = f_trigBear(rtAct, rtLvl, rtStop, rtExp, volMultIn)
var line lnB5 = na
lnB5 := f_track(lnB5, bK5, bF5, rtStart, rtLvl, bar_index + 2, rtLvl, color.new(colDn, 40), colDn)
rtAct := bK5

bearEvent = bF1 or bF2 or bF3 or bF4 or bF5
bearName  = bF1 ? "double/triple top" : bF2 ? "head & shoulders" : bF3 ? "bear flag" : bF4 ? bwName : bF5 ? "rounding top" : ""
var int    bearBar = -100
var string bearLast = ""
if bearEvent
    bearBar := bar_index
    bearLast := bearName
bearFresh = useBear and bar_index - bearBar <= 2

// ============================================================================== 23-27  PRICE ACTION
// 23 Bullish candlestick at a key level: one of 9 bullish candles AND the low within calLevel ATR of a pivot low of the
//    last 100 bars or at/under the lower Bollinger band. Stop 0.2 ATR under the low; target calTpR × risk.
cBody   = math.abs(close - open)
cRng    = math.max(high - low, 1e-12)
upW     = high - math.max(open, close)
loW     = math.min(open, close) - low
cBull   = close > open
pBody   = math.abs(close[1] - open[1])
trendDn = close < ta.sma(close, 10)
bullCandle = (cBull and close[1] < open[1] and close >= open[1] and open <= close[1] and cBody > pBody) or                  // engulfing
     (trendDn and loW >= 2 * cBody and upW <= 0.3 * cBody + 1e-12 and cBody > 0) or                                         // hammer
     (trendDn and upW >= 2 * cBody and loW <= 0.3 * cBody + 1e-12 and cBody > 0) or                                         // inverted hammer
     (close[2] < open[2] and math.abs(close[1] - open[1]) <= 0.3 * math.abs(close[2] - open[2]) and cBull and close > (open[2] + close[2]) / 2) or   // morning star
     (close[1] < open[1] and cBull and open < close[1] and close > (open[1] + close[1]) / 2 and close < open[1]) or        // piercing line
     (cBull and close[1] > open[1] and close[2] > open[2] and close > close[1] and close[1] > close[2]) or                  // three white soldiers
     (trendDn and math.abs(low - low[1]) <= 0.001 * close and close[1] < open[1] and cBull) or                             // tweezer bottom
     (close[1] < open[1] and cBull and open > close[1] and close < open[1] and cBody < pBody) or                           // bullish harami
     (cBull and cBody >= 0.9 * cRng)                                                                                        // bullish marubozu
bool nearPivotLow = false
if bullCandle and nPL > 0
    for j = 0 to nPL - 1
        if array.get(plI, j) >= bar_index - 100 and math.abs(low - array.get(plV, j)) <= calLevel * atr
            nearPivotLow := true
            break
e23 = bullCandle and (nearPivotLow or low <= bbLo)
stop23 = low - 0.2 * atr

// 24 SMC: a sweep of the last confirmed pivot low (wick under, close back above) → within 10 bars a close above the last
//    pivot high (BOS) with a fair-value gap → order block = last red candle before the move; limit at the OB top.
var int   smcFor = -1
var int   smcT = -1
var float smcLvl = na
var float smcSweepLow = na
if smcT < 0 and lastPlI >= 0 and lastPlI != smcFor and bar_index >= lastPlI + K + 1 and bar_index < lastPlI + 60
    if low < lastPlV and close > lastPlV
        smcFor := lastPlI
        if (not smcDiv or rsi > rsi[f_off(lastPlI)]) and lastPhI >= 0
            smcT := bar_index
            smcLvl := lastPhV
            smcSweepLow := low
e24 = false
float stop24 = na
float lim24 = na
if smcT >= 0
    if bar_index > smcT + 10
        smcT := -1
    else if bar_index > smcT and close > smcLvl
        bool fvgOk = false
        if bar_index >= smcT + 2
            for z = math.max(smcT + 2, bar_index - 3) to bar_index
                if low[bar_index - z] > high[bar_index - z + 2]
                    fvgOk := true
        int obOff = -1
        for z = bar_index - 1 to smcT
            if close[bar_index - z] < open[bar_index - z]
                obOff := bar_index - z
                break
        if fvgOk and obOff >= 0 and btcOn
            e24 := true
            lim24 := math.max(open[obOff], close[obOff])
            stop24 := math.min(low[obOff], smcSweepLow) - 0.1 * atr
        smcT := -1

// 25 Bullish RSI failure swing: RSI < 30 → bounce to a peak → higher low above 30 (≥ 5 under the peak) → break of the peak
var int   fsState = 0
var float fsPeak = na
var int   fsPeakI = -1
var int   fsJ = -1
var int   fsKk = -1
var float fsLow = na
e25 = false
if fsState == 0
    if rsi < 30
        fsState := 1
        fsLow := low
else if fsState == 1
    fsLow := math.min(fsLow, low)
    if rsi >= 30
        fsState := 2
        fsJ := bar_index
        fsPeak := rsi
        fsPeakI := bar_index
else if fsState == 2
    fsLow := math.min(fsLow, low)
    if bar_index >= fsJ + 30
        fsState := 0
    else
        if rsi > fsPeak
            fsPeak := rsi
            fsPeakI := bar_index
        if bar_index > fsPeakI + 1 and rsi > 30 and rsi < fsPeak - 5
            fsState := 3
            fsKk := bar_index
else
    fsLow := math.min(fsLow, low)
    if rsi > fsPeak
        e25 := rsi[1] > 30
        fsState := 0
    else if bar_index >= fsKk + 20
        fsState := 0
stop25 = fsLow - 0.2 * atr

// 26 Squeeze breakout: BB width in its lowest sqPct % of 120 bars within the last 5 bars, close above the prior 20-bar high
//    on ≥ sqVol × volume, BTC risk-on. Stop under the 10-bar low; trailing stop after +5 %.
sqNow  = bbw <= ta.percentile_nearest_rank(bbw, 120, sqPct)
e26 = (sqNow or sqNow[1] or sqNow[2] or sqNow[3] or sqNow[4]) and close > hh20[1] and volRatio >= sqVol and btcOn
stop26 = ta.lowest(low, 10) - 0.2 * atr

// 27 VWAP reversion: the previous close > vwZ standard deviations under the 50-bar rolling VWAP, then a close above the
//    prior high. Target = the VWAP; stop under the 5-bar low.
vwap50 = math.sum(hlc3 * volume, 50) / math.sum(volume, 50)
vwDev  = close - vwap50
vwSd   = ta.stdev(vwDev, 50)
vwZs   = vwSd > 0 ? vwDev / vwSd : 0.0
e27 = vwZs[1] < -vwZ and close > high[1]
stop27 = ta.lowest(low, 5) - 0.2 * atr

// ================================================================ THE LIBRARY: metadata (constant) and this candle
f_edge(bool x) => x and not x[1]                                           // state strategies: the candle it switches on
var string[] sCode = array.from("EMA/ADX", "MA-ens", "Donchian", "VolMom", "Pullback", "SMA-off", "BinCluc", "Elliot", "Confl",
     "EMA-x", "ICT", "DD-reclaim", "W-bottom", "iH&S", "Range-brk", "Range-sup", "Flag", "Tri/Wedge", "Cup", "V-bottom",
     "TL-break", "Channel", "Candle", "SMC", "RSI-FS", "Squeeze", "VWAP")
var string[] sName = array.from("Trend baseline EMA50/200+ADX", "MA trend ensemble", "Donchian breakout", "Vol-managed momentum",
     "Trend pullback (NFI)", "SMA offset", "BinCluc Bollinger dip", "Elliot EWO offset", "Confluence score", "EMA cross",
