     "smart money", "rebound", "chart pattern", "chart pattern", "chart pattern", "range", "continuation", "continuation",
     "chart pattern", "chart pattern", "chart pattern", "channel", "candlestick", "smart money", "reversal", "momentum", "mean reversion")
var string[] sReq = array.from("trend", "trend", "trend", "momentum", "trend_pullback", "dip", "dip", "dip", "trend", "any", "any",
     "any", "any", "any", "any", "range", "trend", "any", "any", "any", "any", "trend_pullback", "any", "any", "any", "momentum", "dip")
var bool[] sChopOk = array.from(false, false, false, false, false, true, true, true, false, false, false, false, false, false, false,
     true, false, false, false, false, false, true, true, false, false, false, true)    // the bot's RANGE_FAMILIES
var string[] sMode = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19,
     s20, s21, s22, s23, s24, s25, s26, s27)
var string[] sHow = array.from(
     "Long while close > EMA50 > EMA200, RSI > 50, ADX > " + str.tostring(adxMin) + " with +DI > −DI and BTC risk-on. Exit: close < EMA50. Stop 2 ATR.",
     "One vote per SMA 20/50/100 that price is above and that is rising (vs 3 bars ago). Long at ≥ " + str.tostring(maVotes) + " votes, exit at ≤ 1. Stop 3 ATR.",
     "Long on a close above the prior " + str.tostring(donN) + "-bar high. Exit on a close under the prior " + str.tostring(math.max(5, math.floor(donN / 2))) + "-bar low. Stop 2 ATR.",
     str.tostring(momL) + "-bar return ÷ (30-bar volatility × √" + str.tostring(momL) + ") > " + str.tostring(momMin) + ", beating BTC over the same period, not in the top 10 % volatility (crash filter). Exit when momentum or relative strength turns negative. Stop 3 ATR.",
     "Higher-timeframe uptrend + BTC risk-on + safe dip (RSI < " + str.tostring(pbRsi) + " and ≥ 1 ATR under EMA20) + pump guard + volume ≥ 0.7× + EWO above its 5th percentile. Exit: close > EMA20 or RSI > 65; 24-bar limit.",
     "Close < SMA14 × " + str.tostring(smaOff) + " with EWO > " + str.tostring(smaEwo) + ", RSI < 50, RSI(4) < 35 — or EWO < −8 with RSI(4) < 25. BTC risk-on, pump guard. Exit: close > SMA20 × 1.01 and RSI > 50; ROI 8 %→3 %→0.5 %, trail 1 % after +2 %.",
     "BinHV45: close under the prior lower BB40 after a wide band and a big red candle with a small tail — or ClucMay: close < EMA50 and < lower BB20 × " + str.tostring(clucMult) + ". Exit: close > BB20 middle; ROI 5 %→2 %→0 %.",
     "Close < EMA17 × " + str.tostring(ellOff) + " with EWO > " + str.tostring(ellEwo) + " and RSI < 65 — or capitulation EWO < −19. BTC risk-on. Exit: close > EMA49 × 1.006; ROI 20 %→4 %→0 %, trail 1 % after +3 %.",
     "6 parts: EMA20>50>200 · RSI 50-70 · ADX > 20 with +DI · volume > 1.2× · close > SMA20 with widening BB · MACD histogram > 0 and rising. Long at ≥ " + str.tostring(confK) + ", exit at ≤ 2; early-loss cuts, trail 2.5 % after +5 %.",
